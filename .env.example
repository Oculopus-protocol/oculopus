# Funded Arc-testnet wallet the buyer agent pays from (0x-prefixed private key).
# Faucet: https://faucet.circle.com (Arc Testnet USDC — gas is USDC-denominated).
BUYER_PRIVATE_KEY=

# Where verify:memo sends its 0.01 USDC test transfer (any address you control).
RECIPIENT=

# Optional: comma-separated gateway witness addresses whose receipt signatures
# count as the attested tier (WITNESS ×3 weight). Empty = indexed tier only.
WITNESS_ADDRESSES=

# Optional overrides
# Which Arc network this process talks to: testnet (default, chain 5042002) or
# mainnet (chain 5042). Receipts never mix — the EIP-712 domain carries the chainId.
# Run the two side by side with their own port and state dir, e.g.
#   npm run node            (testnet, :8790, data/)
#   npm run node:mainnet    (mainnet, :8791, data-mainnet/)
# OCULOPUS_NETWORK=testnet
# NODE_PORT=8790
# OCULOPUS_STATE_DIR=data
# Defaults to Arc's public RPC. Set only if you hit -32005 / 429 (e.g. a big backfill):
# point at any Arc-testnet RPC provider — free thirdweb id, Alchemy/Ankr, or your own.
# OCULOPUS_RPC_URLS=
# Same, but for the mainnet node. Kept separate on purpose: a keyed testnet endpoint in
# front of the mainnet list would fail the chainId guard at startup.
# OCULOPUS_RPC_URLS_MAINNET=
# Delay (ms) between successive eth_getLogs during backfill / lookups. Default 120; set 0
# on a dedicated / unlimited RPC.
# OCULOPUS_RPC_THROTTLE_MS=120
# Largest request body the node will read, in bytes. Anything bigger gets a 413 instead of
# being buffered. Default 262144 (256KB) — a receipt is far smaller than that.
# OCULOPUS_MAX_BODY_BYTES=262144
# How long /scores may serve a cached answer, in ms. Any state write clears the cache
# anyway, so a new receipt still appears at once. Default 30000.
# OCULOPUS_SCORES_TTL_MS=30000
# How many receipts may sit unverified (waiting for their on-chain anchor) before the node
# stops accepting new ones. Default 5000.
# OCULOPUS_MAX_PENDING_RECEIPTS=5000
# Where `npm run seed` / `seed:x402` POST receipt documents. Defaults to the live node; for a
# LOCAL demo point it at your own node so receipts are stored + scored locally (else UNRATED).
# OC_NODE_URL=http://localhost:8790
# Start indexing from this block; also fast-forwards an existing index. Near head = fast demo.
# OCULOPUS_START_BLOCK=
# Comma-separated ERC-8004 agentIds to pin in the directory before they have receipts.
# OCULOPUS_AGENT_IDS=
# Node role: reference (all-in-one, default) | indexer (light) | worker (heavy job scan + scoring).
# OCULOPUS_ROLE=
# On a split indexer, merge a worker's richer (job-inclusive) scores from its /scores.
# OCULOPUS_SCORER_URL=http://127.0.0.1:8792

# ── Circle developer-controlled wallet: treasury that receives x402 reputation payments ──
# Testnet API key from console.circle.com (format PREFIX:ID:SECRET). Never commit.
CIRCLE_API_KEY=
# 32-byte hex from `npm run circle:gen`, then registered with `npm run circle:register`. Never commit.
ENTITY_SECRET=
# Filled in by `npm run circle:wallet`.
CIRCLE_WALLET_SET_ID=
OCULOPUS_TREASURY_WALLET_ID=
OCULOPUS_TREASURY_ADDRESS=

# ── Paid oracle (x402 pay-per-call) + developer dashboard ──
# At runtime the oracle only needs OCULOPUS_TREASURY_ADDRESS (above, the payTo). Rest optional.
# ORACLE_PORT=8791
# ORACLE_UPSTREAM=http://localhost:8790
# ORACLE_PRICE=$0.0001
# HMAC secret for dashboard sessions — set so sign-ins survive oracle restarts. `openssl rand -hex 32`
# The oracle warns loudly at boot when this is unset. ALWAYS set it in production.
# ORACLE_SESSION_SECRET=
# Monthly quota for CLI-minted keys only (`npm run key:create`, no owning wallet). A wallet's
# allowance comes from its earned tier instead — see plans.ts. Default 1000.
# ORACLE_FREE_LIMIT=1000

# ── Free-tier gate: a wallet earns its allowance from its own Oculopus record ──
# unverified 100/mo · verified (>=1 anchored receipt) 1000/mo · trusted 5000/mo.
# Thresholds for the trusted tier — deliberately the same signals the scorer uses, so
# farming the tier costs what farming a score costs: funded counterparties and time.
# ORACLE_TRUSTED_MIN_SCORE=30
# ORACLE_TRUSTED_MIN_COUNTERPARTIES=3
# Keys per wallet. Extra keys never add quota; the cap keeps the usage lookup fast.
# ORACLE_MAX_KEYS_PER_OWNER=10
# Sign-in nonces held in memory at once. The endpoint is free and unauthenticated, so the
# table is caller-controlled and bounded; past this it 503s rather than growing. Default 20000.
# ORACLE_MAX_NONCES=20000
# Rate-limit buckets held at once, and how long an idle one survives before eviction.
# ORACLE_MAX_BUCKETS=50000
# ORACLE_BUCKET_IDLE_MS=600000

# ── Autonomous buyer agent (npm run agent:creditcheck -- 0x<addr>) ──
# Oracle it credit-checks against (live: https://api.oculopus.xyz).
# ORACLE_URL=http://localhost:8791
# Minimum acceptable tier before the agent proceeds. Default SILVER.
# CREDIT_MIN_TIER=SILVER
