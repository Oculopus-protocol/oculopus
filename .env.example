# Funded Arc-testnet wallet the buyer agent pays from (0x-prefixed private key).
# Faucet: https://faucet.circle.com (Arc Testnet USDC — gas is USDC-denominated).
BUYER_PRIVATE_KEY=

# Where verify:memo sends its 0.01 USDC test transfer (any address you control).
RECIPIENT=

# Optional: comma-separated gateway witness addresses whose receipt signatures
# count as the attested tier (WITNESS ×3 weight). Empty = indexed tier only.
WITNESS_ADDRESSES=

# Optional overrides
# NODE_PORT=8790
# OCULOPUS_STATE_DIR=data
# Defaults to Arc's public RPC. Set only if you hit -32005 / 429 (e.g. a big backfill):
# point at any Arc-testnet RPC provider — free thirdweb id, Alchemy/Ankr, or your own.
# OCULOPUS_RPC_URLS=
# Delay (ms) between successive eth_getLogs during backfill / lookups. Default 120; set 0
# on a dedicated / unlimited RPC.
# OCULOPUS_RPC_THROTTLE_MS=120
# Where `npm run seed` / `seed:x402` POST receipt documents. Defaults to the live node; for a
# LOCAL demo point it at your own node so receipts are stored + scored locally (else UNRATED).
# OC_NODE_URL=http://localhost:8790
# Start indexing from this block; also fast-forwards an existing index. Near head = fast demo.
# OCULOPUS_START_BLOCK=
# Comma-separated ERC-8004 agentIds to pin in the directory before they have receipts.
# OCULOPUS_AGENT_IDS=
# Node role: reference (all-in-one, default) | indexer (light) | worker (heavy job scan + scoring).
# OCULOPUS_ROLE=
# On a split indexer, merge a worker's richer (job-inclusive) scores from its /scores.
# OCULOPUS_SCORER_URL=http://127.0.0.1:8792

# ── Circle developer-controlled wallet: treasury that receives x402 reputation payments ──
# Testnet API key from console.circle.com (format PREFIX:ID:SECRET). Never commit.
CIRCLE_API_KEY=
# 32-byte hex from `npm run circle:gen`, then registered with `npm run circle:register`. Never commit.
ENTITY_SECRET=
# Filled in by `npm run circle:wallet`.
CIRCLE_WALLET_SET_ID=
OCULOPUS_TREASURY_WALLET_ID=
OCULOPUS_TREASURY_ADDRESS=

# ── Paid oracle (x402 pay-per-call) + developer dashboard ──
# At runtime the oracle only needs OCULOPUS_TREASURY_ADDRESS (above, the payTo). Rest optional.
# ORACLE_PORT=8791
# ORACLE_UPSTREAM=http://localhost:8790
# ORACLE_PRICE=$0.0001
# HMAC secret for dashboard sessions — set so sign-ins survive oracle restarts. `openssl rand -hex 32`
# ORACLE_SESSION_SECRET=
# Monthly free-read quota per wallet. Default 10000.
# ORACLE_FREE_LIMIT=10000

# ── Autonomous buyer agent (npm run agent:creditcheck -- 0x<addr>) ──
# Oracle it credit-checks against (live: https://api.oculopus.xyz).
# ORACLE_URL=http://localhost:8791
# Minimum acceptable tier before the agent proceeds. Default SILVER.
# CREDIT_MIN_TIER=SILVER
